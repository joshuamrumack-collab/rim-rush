; Engine configuration file.
config_version=5

[application]

config/name="Rim Rush - Wheelchair Soccer"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.04, 0.05, 0.12, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false

[autoload]

Game="*res://scripts/game_state.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.web=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/screen_space_aa.web=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
environment/volumetric_fog/volume_size=96
